rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'kenyojohnsonroberto@gmail.com') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read their own profile, or an admin can read all profiles
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // Users can create their own profile upon registration (cannot self-grant admin unless founder bootstrap)
      allow create: if isAuthenticated() && isOwner(userId) && (
        (request.resource.data.role != 'admin' && request.resource.data.isAdmin != true) ||
        (request.auth.token.email == 'kenyojohnsonroberto@gmail.com') ||
        isAdmin()
      );

      // Normal users can update their profile information but CANNOT elevate their own role or isAdmin flag
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])
        )
      );

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // Admins Collection (Strict access control list)
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Settings Collection (Platform payment configs: OM, MOMO, fees, etc.)
    match /settings/{settingId} {
      // Platform payment coordinates must be readable for checkout verification
      allow read: if isAuthenticated();
      // Only verified admins can modify payment configuration or platform details
      allow write: if isAdmin();
    }

    // Audit Logs (Immutable security tracking)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Newsletter Subscribers (Community updates)
    match /newsletter_subscribers/{subscriberId} {
      // Any authenticated or anonymous user can subscribe their email
      allow create: if isAuthenticated() &&
                    request.resource.data.email is string &&
                    request.resource.data.email.matches('.*@.*') &&
                    request.resource.data.status == 'active';
      // Only admins can view the subscriber list or delete/update records
      allow read, update, delete: if isAdmin();
    }
  }
}

